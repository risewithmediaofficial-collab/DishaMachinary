doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Thermal Bill - #{settings.company_name || 'Disha Machinary'} ##{model.number}
    style.
      @page {
        size: 80mm auto;
        margin: 3mm 3mm 6mm 3mm;
      }
      * {
        box-sizing: border-box;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      body {
        margin: 0;
        padding: 4px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Courier New", monospace, sans-serif;
        font-size: 11px;
        color: #000000;
        background: #ffffff;
        line-height: 1.35;
        width: 74mm;
        max-width: 74mm;
      }
      .thermal-bill {
        width: 100%;
      }
      .center {
        text-align: center;
      }
      .right {
        text-align: right;
      }
      .left {
        text-align: left;
      }
      .bold {
        font-weight: 700;
      }
      .shop-name {
        font-size: 16px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 2px;
      }
      .shop-sub {
        font-size: 9.5px;
        margin: 1px 0;
      }
      .divider-double {
        border-top: 1px dashed #000;
        border-bottom: 1px dashed #000;
        height: 3px;
        margin: 6px 0;
      }
      .divider-single {
        border-top: 1px dashed #000;
        margin: 5px 0;
      }
      .bill-type {
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        margin: 3px 0;
      }
      .meta-line {
        display: flex;
        justify-content: space-between;
        font-size: 10px;
        margin: 1px 0;
      }
      .items-header {
        display: flex;
        justify-content: space-between;
        font-size: 10px;
        font-weight: 700;
        border-top: 1px dashed #000;
        border-bottom: 1px dashed #000;
        padding: 3px 0;
        margin: 5px 0 3px 0;
      }
      .item-row {
        margin-bottom: 5px;
        font-size: 10px;
      }
      .item-name {
        font-weight: 700;
      }
      .item-calc {
        display: flex;
        justify-content: space-between;
        font-size: 9.5px;
        color: #111;
        margin-top: 1px;
      }
      .item-gst-tag {
        font-size: 8.5px;
        color: #333;
      }
      .totals-area {
        margin-top: 4px;
        font-size: 10.5px;
      }
      .total-line {
        display: flex;
        justify-content: space-between;
        margin: 2px 0;
      }
      .grand-total {
        font-size: 13.5px;
        font-weight: 800;
        border-top: 1px dashed #000;
        border-bottom: 1px dashed #000;
        padding: 5px 0;
        margin: 5px 0;
      }
      .footer-section {
        margin-top: 8px;
        font-size: 9px;
        line-height: 1.3;
      }
      .barcode-box {
        margin-top: 6px;
        font-family: monospace;
        letter-spacing: 2px;
        font-size: 10px;
      }

  body
    .thermal-bill
      .center
        .shop-name #{settings.company_name || 'Disha Machinary'}
        .shop-sub MACHINERY • SPARES • TOOLS
        .shop-sub #{settings.company_address || 'Plot No. 12, Industrial Estate, Machinery Hub'}
        if settings.company_phone
          .shop-sub Ph: #{settings.company_phone}
        if settings.company_gstin
          .shop-sub.bold GSTIN: #{settings.company_gstin}

      .divider-double
      .center
        .bill-type #{model.gstEnabled ? 'TAX INVOICE' : 'CASH / RETAIL RECEIPT'}

      .meta-line
        span Bill No: ##{model.number}/#{model.year || ''}
        span #{moment(model.date).format('DD/MM/YY HH:mm')}
      if model.client
        .meta-line
          span Cust: #{model.client.name || 'Walk-in Customer'}
          if model.client.phone
            span Ph: #{model.client.phone}
        if model.buyerGstin || model.client.gstin
          .meta-line
            span GSTIN: #{model.buyerGstin || model.client.gstin}

      .items-header
        span Item Description
        span Amount

      - var totalQty = 0
      each item in (model.items || [])
        - totalQty += Number(item.quantity || 0)
        .item-row
          .item-name #{item.itemName}
          .item-calc
            span #{item.quantity} x #{moneyFormatter({ amount: item.price, currency_code: model.currency })}
            span.bold #{moneyFormatter({ amount: item.lineTotal || item.total, currency_code: model.currency })}
          if item.hsnCode || (model.gstEnabled && item.gstRate)
            .item-gst-tag
              | #{item.hsnCode ? 'HSN:' + item.hsnCode + ' ' : ''}#{model.gstEnabled ? 'GST:' + (item.gstRate || 0) + '%' : ''}

      .divider-single
      .totals-area
        .total-line
          span Sub Total:
          span #{moneyFormatter({ amount: model.subTotal, currency_code: model.currency })}
        if model.discount && model.discount > 0
          .total-line
            span Discount:
            span - #{moneyFormatter({ amount: model.discount, currency_code: model.currency })}
        if model.gstEnabled
          if model.supplyType === 'intrastate'
            .total-line
              span CGST:
              span #{moneyFormatter({ amount: model.cgstTotal, currency_code: model.currency })}
            .total-line
              span SGST:
              span #{moneyFormatter({ amount: model.sgstTotal, currency_code: model.currency })}
          else
            .total-line
              span IGST:
              span #{moneyFormatter({ amount: model.igstTotal, currency_code: model.currency })}
        .grand-total.total-line
          span NET PAYABLE:
          span #{moneyFormatter({ amount: model.total, currency_code: model.currency })}

        if model.credit !== undefined && model.credit > 0
          .total-line
            span Paid Amount:
            span.bold #{moneyFormatter({ amount: model.credit, currency_code: model.currency })}
          .total-line
            span Balance Due:
            span #{moneyFormatter({ amount: Math.max(0, model.total - model.credit), currency_code: model.currency })}

      .divider-single
      .meta-line
        span Total Items: #{model.items ? model.items.length : 0}
        span Total Qty: #{totalQty}

      .divider-double
      .footer-section.center
        .bold * THANK YOU FOR YOUR BUSINESS *
        div For Support & Service: #{settings.company_phone || '+91 98765 43210'}
        div Goods once sold subject to warranty terms.
        .barcode-box *DM-INV-#{model.number}-#{model.year}*
        div *** DISHA MACHINARY ***
