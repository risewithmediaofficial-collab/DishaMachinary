doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title #{settings.company_name || 'DISHA MACHINERY'} - Tax Invoice #{model.number}
    style.
      @page {
        size: A4 portrait;
        margin: 6mm 8mm;
      }
      * {
        box-sizing: border-box;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      body {
        margin: 0;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        font-size: 11px;
        color: #000;
        background: #ffffff;
        line-height: 1.35;
      }
      .bill-outer {
        border: 1.5px solid #000;
        padding: 10px 12px 6px;
      }
      .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 5px;
        border-bottom: 1px solid #000;
        font-size: 11px;
      }
      .top-gstin { font-weight: 700; }
      .top-title { font-weight: 800; font-size: 13px; letter-spacing: 0.5px; }
      .top-mobile { color: #991b1b; font-weight: 700; }
      .brand-section {
        text-align: center;
        padding: 6px 0 8px;
        position: relative;
      }
      .brand-name {
        font-size: 26px;
        font-weight: 800;
        color: #2e7d32;
        font-family: Georgia, "Times New Roman", serif;
        letter-spacing: 1px;
        margin: 0;
      }
      .brand-tagline {
        font-size: 10px;
        font-weight: 700;
        color: #1e293b;
        margin: 2px 0;
      }
      .brand-address {
        font-size: 11px;
        font-weight: 600;
        color: #1e293b;
      }
      .brand-phones {
        font-size: 11px;
        font-weight: 700;
        color: #991b1b;
        margin-top: 2px;
      }
      .parties-grid {
        display: flex;
        border: 1px solid #000;
        font-size: 10.5px;
        margin-top: 6px;
      }
      .party-box {
        flex: 1.1;
        padding: 6px 8px;
        border-right: 1px solid #000;
      }
      .party-header {
        color: #1d4ed8;
        font-weight: 700;
        text-decoration: underline;
        margin-bottom: 3px;
      }
      .party-name {
        font-weight: 800;
        color: #991b1b;
        font-size: 12px;
        text-transform: uppercase;
      }
      .party-addr {
        font-weight: 700;
        text-transform: uppercase;
        color: #000;
      }
      .party-row {
        display: flex;
        justify-content: space-between;
        margin-top: 2px;
      }
      .party-mobile {
        color: #991b1b;
        font-weight: 700;
      }
      .meta-box {
        flex: 1.1;
        padding: 6px 8px;
      }
      .meta-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 2px;
      }
      .meta-lbl { font-weight: 600; }
      .meta-val { font-weight: 700; }
      .inv-no { color: #991b1b; font-weight: 800; }
      table.bill-table {
        width: 100%;
        border-collapse: collapse;
        border-left: 1px solid #000;
        border-right: 1px solid #000;
        border-bottom: 1px solid #000;
        font-size: 10px;
      }
      table.bill-table th {
        border: 1px solid #000;
        padding: 5px 3px;
        font-weight: 700;
        text-align: center;
        background: #fff;
      }
      table.bill-table td {
        border-left: 1px solid #000;
        border-right: 1px solid #000;
        padding: 4px;
        vertical-align: top;
      }
      .right { text-align: right; }
      .center { text-align: center; }
      .bottom-grid {
        display: flex;
        border-left: 1px solid #000;
        border-right: 1px solid #000;
        border-bottom: 1px solid #000;
        padding: 6px 8px;
        gap: 8px;
        font-size: 10px;
      }
      .bottom-left { flex: 1.4; }
      .bank-header {
        color: #991b1b;
        font-weight: 700;
        text-decoration: underline;
        margin-bottom: 3px;
      }
      .bank-row {
        color: #1e40af;
        font-weight: 700;
        margin-bottom: 2px;
      }
      .bank-split {
        display: flex;
        justify-content: space-between;
        color: #1e40af;
        font-weight: 700;
        margin-bottom: 2px;
      }
      .words-line {
        margin-top: 6px;
        padding-top: 4px;
        border-top: 1px solid #000;
        font-weight: 700;
      }
      .terms-line {
        margin-top: 4px;
        font-size: 9.5px;
        font-weight: 600;
      }
      .bottom-center {
        flex: 0.8;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-left: 1px dashed #000;
        border-right: 1px dashed #000;
      }
      .qr-img { width: 90px; height: 90px; }
      .bottom-right { flex: 1.3; }
      .calc-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 2px;
      }
      .total-box {
        display: flex;
        justify-content: space-between;
        border: 1.5px solid #000;
        padding: 3px 6px;
        margin: 5px 0 6px;
        font-size: 12px;
        font-weight: 800;
        color: #991b1b;
      }
      .footer-banner {
        text-align: center;
        color: #1e40af;
        font-weight: 700;
        font-size: 10.5px;
        margin-top: 6px;
        padding-top: 4px;
        border-top: 1px solid #e2e8f0;
      }
  body
    - var yr = model.year || new Date().getFullYear();
    - var y1 = yr % 100;
    - var y2 = (yr + 1) % 100;
    - var pfx = (y1 < 10 ? '0' + y1 : y1) + '-' + (y2 < 10 ? '0' + y2 : y2);
    - var invNo = pfx + '/' + model.number;
    - var client = model.client || {};
    - var items = model.items || [];
    - var dateFormatted = moment(model.date).format('DD/MM/YYYY');
    - var upiId = settings.company_upi || '9751117889@federal';
    - var upiUrl = 'upi://pay?pa=' + upiId + '&pn=' + encodeURIComponent(settings.company_name || 'DISHA MACHINERY') + '&am=' + Number(model.total || 0).toFixed(2) + '&cu=INR';
    - var qrUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=' + encodeURIComponent(upiUrl);

    .bill-outer
      .top-bar
        .top-gstin <strong>GSTIN :</strong> #{settings.company_gstin || '33GPNPS1888N1ZT'}
        .top-title TAX INVOICE
        .top-mobile <strong>Mobile :</strong> 9751117889

      .brand-section
        h1.brand-name #{settings.company_name || 'DISHA MACHINERY'}
        .brand-tagline #{settings.company_tagline || '[ All Kinds of Machinery, All Kinds of Welding & Wiring Equipment and foods ]'}
        .brand-address #{settings.company_address || 'Annamalai Complex, New Busstand, Tirupattur Dist - 635601'}
        .brand-phones <strong>Mobile :</strong> #{settings.company_phone || '9626957000/04179-2266666/294650'}

      .parties-grid
        .party-box
          .party-header Billed to
          .party-name #{client.name || 'HALEEM BASHA'}
          .party-addr #{client.address || 'TIRUPATTUR'}
          .party-addr #{client.state || 'TIRUPATTUR'}
          .party-row
            span GSTIN :
            span #{model.buyerGstin || client.gstin || ''}
          .party-row.party-mobile
            span Mobile No :
            span #{client.phone || '8122638760'}

        .party-box
          .party-header Consignee / Shipped to
          .party-name #{model.consigneeName || client.name || 'HALEEM BASHA'}
          .party-addr #{model.consigneeAddress || client.address || 'TIRUPATTUR'}
          .party-addr #{client.state || 'TIRUPATTUR'}
          .party-row
            span GSTIN :
            span #{model.consigneeGstin || model.buyerGstin || client.gstin || ''}
          .party-row.party-mobile
            span Mobile No :
            span #{model.consigneePhone || client.phone || '8122638760'}

        .meta-box
          .meta-row
            span.meta-lbl Invoice No :
            span.meta-val.inv-no #{invNo}
          .meta-row
            span.meta-lbl Invoice Date :
            span.meta-val #{dateFormatted}
          .meta-row
            span.meta-lbl Vehicle No :
            span.meta-val #{model.vehicleNo || ''}
          .meta-row
            span.meta-lbl Transport :
            span.meta-val #{model.transport || ''}

      table.bill-table
        thead
          tr
            th(style="width: 4%;" rowspan="2") No
            th(style="width: 28%;" rowspan="2") Particulars
            th(style="width: 9%;" rowspan="2") Hsn Code
            th(style="width: 10%;" rowspan="2") Rate
            th(style="width: 12%;" colspan="2") Qty
            th(style="width: 7%;" rowspan="2") GST %
            th(style="width: 8%;" rowspan="2") CGST
            th(style="width: 8%;" rowspan="2") SGST
            th(style="width: 8%;" rowspan="2") IGST
            th(style="width: 12%;" rowspan="2") Amount
          tr
            th(style="width: 6%; font-size: 8.5px;") Qty/wet
            th(style="width: 6%; font-size: 8.5px;") Nos/lth
        tbody
          each item, idx in items
            tr
              td.center #{idx + 1}
              td(style="font-weight: 700;") #{item.itemName}
              td.center #{item.hsnCode || '-'}
              td.right #{Number(item.price || 0).toFixed(2)}
              td.center #{item.quantity}
              td.center
              td.center #{item.gstRate ? Number(item.gstRate).toFixed(2) : '0.00'}
              td.right #{item.cgst ? Number(item.cgst).toFixed(2) : (model.gstEnabled && model.supplyType === 'intrastate' ? (Number(item.taxAmount || 0) / 2).toFixed(2) : '')}
              td.right #{item.sgst ? Number(item.sgst).toFixed(2) : (model.gstEnabled && model.supplyType === 'intrastate' ? (Number(item.taxAmount || 0) / 2).toFixed(2) : '')}
              td.right #{item.igst ? Number(item.igst).toFixed(2) : (model.gstEnabled && model.supplyType === 'interstate' ? Number(item.taxAmount || 0).toFixed(2) : '')}
              td.right(style="font-weight: 700;") #{Number(item.taxableValue || item.total || (item.quantity * item.price)).toFixed(2)}

          - var phCount = Math.max(0, 5 - items.length);
          - for (var i = 0; i < phCount; i++)
            tr(style="height: 22px;")
              td &nbsp;
              td &nbsp;
              td &nbsp;
              td &nbsp;
              td &nbsp;
              td &nbsp;
              td &nbsp;
              td &nbsp;
              td &nbsp;
              td &nbsp;
              td &nbsp;

      .bottom-grid
        .bottom-left
          .bank-header Bank Details
          .bank-row <strong>A/C NAME :</strong> #{settings.company_name || 'DISHA MACHINERY'}
          .bank-split
            span <strong>A/C NO :</strong> #{settings.company_bank_account || '20695500000537'}
            span <strong>IFSC :</strong> #{settings.company_bank_ifsc || 'FDRL0002069'}
          .bank-split
            span <strong>BANK :</strong> #{settings.company_bank_name || 'FEDERAL BANK'}
            span <strong>BRANCH :</strong> #{settings.company_bank_branch || 'TIRUPATHUR'}
          .words-line #{typeof numberToWords === 'function' ? numberToWords(model.total) : ('Rupees ' + (model.total || 0) + ' Only')}
          .terms-line 1. Goods Once sold Cannot be taken back

        .bottom-center
          img.qr-img(src=qrUrl alt="UPI QR")
          div(style="font-size: 8px; font-weight: 700; color: #1e40af; margin-top: 2px;") Scan & Pay via UPI

        .bottom-right
          .calc-row
            span Freight
            span #{model.freight ? Number(model.freight).toFixed(2) : ''}
          .calc-row
            span CGST :
            span #{model.cgstTotal ? Number(model.cgstTotal).toFixed(2) : (model.gstEnabled && model.supplyType === 'intrastate' ? (Number(model.taxTotal || 0) / 2).toFixed(2) : '')}
          .calc-row
            span SGST :
            span #{model.sgstTotal ? Number(model.sgstTotal).toFixed(2) : (model.gstEnabled && model.supplyType === 'intrastate' ? (Number(model.taxTotal || 0) / 2).toFixed(2) : '')}
          .calc-row
            span IGST :
            span #{model.igstTotal ? Number(model.igstTotal).toFixed(2) : (model.gstEnabled && model.supplyType === 'interstate' ? Number(model.taxTotal || 0).toFixed(2) : '')}
          .total-box
            span TOTAL :
            span #{Number(model.total || 0).toFixed(2)}
          div(style="text-align: right; margin-top: 4px;")
            div(style="font-size: 9.5px; font-weight: 700;") For #{settings.company_name || 'DISHA MACHINERY'}
            div(style="height: 24px;")
            div(style="font-size: 9px; font-weight: 600;") Authorized Signatory

      .footer-banner
        | Thanks so much for your purchase! You made our day, so we hope you have a great one yourself. See you again soon!
